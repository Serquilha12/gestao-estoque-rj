# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - TK RUI JÚNIOR
# Copie este ficheiro para `.env` e preencha com as credenciais do seu Supabase.
# ==============================================================================

# 1. Supabase Database (PostgreSQL Connection Pooling - porta 6543 para Serverless/Vercel)
# Obtido em: Supabase Dashboard > Project Settings > Database > Connection string > URI (Transaction)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SUA_SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase API (Obtido em: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Chave secreta de autenticação de sessão
JWT_SECRET="tk-rui-junior-secret-key-prod-2026-safe-token"
