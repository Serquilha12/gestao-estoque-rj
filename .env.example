# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - TAKE AWAY RUI JÚNIOR
# ==============================================================================

# 1. URL de Pooling para a aplicação operar o POS e Next.js Serverless (Porta 6543)
# Obtido em: Supabase Dashboard > Project Settings > Database > Connection string > URI (Transaction / Session Pooler)
DATABASE_URL="postgres://postgres.[PROJECT_REF]:[SUA_SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2. URL Direta para rodar migrações, Prisma contract / DDL (Porta 5432)
# Obtido em: Supabase Dashboard > Project Settings > Database > Connection string > URI (Direct connection)
DIRECT_URL="postgres://postgres:[SUA_SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres"

# 3. Supabase REST API (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. Chave secreta de autenticação e sessão JWT
JWT_SECRET="tk-rui-junior-secret-key-prod-2026-safe-token"
BETTER_AUTH_SECRET="tk-rui-junior-secret-key-prod-2026-safe-token"

# 5. URL da aplicação (opcional, para CORS e Auth)
# NEXT_PUBLIC_APP_URL="https://tkruijunior.co.mz"
